    "Tap \"Capture Defect\" below to snap photos, draw red callouts, and dictate a voice memo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap \"Capture Defect\" below to snap photos, draw red callouts, and dictate a voice memo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa \"Registrar Defecto\" abajo para tomar fotos, dibujar marcas rojas y dictar una nota de voz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击下方“采集缺陷”即可拍照、画红框标注并录制语音。"
          }
        },
        "zh-Hant" : {
