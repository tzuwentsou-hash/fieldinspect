          }
        }
      }
    },
    "Tap + to start a new residential inspection. Snap defect photos, draw callouts, and dictate findings—even offline." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap + to start a new residential inspection. Snap defect photos, draw callouts, and dictate findings—even offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa + para iniciar una nueva inspección residencial. Toma fotos, dibuja marcas y dicta hallazgos, incluso sin conexión."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击右上角 + 开始新的住宅验房。支持现场拍照、红框标注及离线语音口述。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下右上角 + 開始新的住宅驗屋。支援現場拍照、紅框標註及離線語音口述。"
          }
        }
      }
    },
    "Terms of Use (EULA)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terms of Use (EULA)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Términos de Uso (EULA)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用条款 (EULA)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用條款 (EULA)"
          }
        }
      }
    },
    "This residential inspection report is a visual, non-invasive evaluation of the readily accessible building systems and components as observed on the date of inspection. It is performed in accordance with InterNACHI Standards of Practice and is not a building code compliance audit, engineering study, or warranty/guarantee of future performance. Concealed, latent, or inaccessible defects are excluded. Any safety hazards or major defects identified herein should be further evaluated and repaired by qualified, licensed trade specialists prior to closing." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This residential inspection report is a visual, non-invasive evaluation of the readily accessible building systems and components as observed on the date of inspection. It is performed in accordance with InterNACHI Standards of Practice and is not a building code compliance audit, engineering study, or warranty/guarantee of future performance. Concealed, latent, or inaccessible defects are excluded. Any safety hazards or major defects identified herein should be further evaluated and repaired by qualified, licensed trade specialists prior to closing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este informe de inspección residencial es una evaluación visual y no invasiva de los sistemas y componentes del inmueble fácilmente accesibles, tal como se observaron en la fecha de la inspección. Se realiza conforme a las Normas de Práctica de InterNACHI y no constituye una auditoría de cumplimiento del código de construcción, un estudio de ingeniería ni una garantía de desempeño futuro. Se excluyen los defectos ocultos, latentes o inaccesibles. Todo riesgo de seguridad o defecto grave aquí identificado debe ser evaluado y reparado por especialistas calificados y con licencia antes del cierre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本住宅验房报告是对验房当日可直接到达的建筑系统及构件所作的目视、非破坏性评估，依据 InterNACHI 执业标准执行，并非建筑规范合规审查、工程鉴定，亦不构成对未来性能的保证或担保。隐蔽、潜在或无法到达部位的缺陷不在检验范围内。本报告所列的任何安全隐患或重大缺陷，均应在交易完成前由具备资质的持证专业人员进一步评估并维修。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本住宅驗屋報告係針對驗屋當日可直接到達之建築系統及構件所作的目視、非破壞性評估，依據 InterNACHI 執業標準執行，並非建築法規合規審查、工程鑑定，亦不構成對未來性能之保證或擔保。隱蔽、潛在或無法到達部位之缺失不在檢驗範圍內。本報告所列之任何安全疑慮或重大缺失，均應於交屋前由合格之持照專業人員進一步評估並修繕。"
          }
        }
      }
    },
