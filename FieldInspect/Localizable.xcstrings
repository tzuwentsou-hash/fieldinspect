    "At least one photo, voice memo, or text note is required for AI analysis." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least one photo, voice memo, or text note is required for AI analysis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita al menos una foto, nota de voz o nota de texto para el análisis con IA."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 分析至少需要一张照片、一段语音备忘录或一条文字备注。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 分析至少需要一張照片、一段語音備忘錄或一則文字備註。"
          }
        }
      }
    },
    "Attached inspection photos and voice memos are transmitted securely to FieldInspect's stateless AI proxy (Google Gemini API) solely to generate your InterNACHI defect narrative. Data is not retained by the proxy." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attached inspection photos and voice memos are transmitted securely to FieldInspect's stateless AI proxy (Google Gemini API) solely to generate your InterNACHI defect narrative. Data is not retained by the proxy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos de inspección y notas de voz se transmiten de forma segura al proxy de IA sin estado de FieldInspect (Google Gemini API) únicamente para generar el informe InterNACHI. El proxy no retiene los datos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所附验房照片与语音备忘录将通过加密通道发送至 FieldInspect 无状态 AI 代理（Google Gemini API），仅用于生成 InterNACHI 规范的缺陷描述，代理服务器不会留存您的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所附驗屋照片與語音備忘錄將透過加密通道傳送至 FieldInspect 無狀態 AI 代理（Google Gemini API），僅用於產生 InterNACHI 規範的缺失描述，代理伺服器不會留存您的資料。"
          }
        }
      }
    },
